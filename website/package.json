{
  "name": "rship-docs",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Standalone public documentation site for rship",
  "scripts": {
    "sync-assets": "node scripts/sync-assets.mjs",
    "gen-meta": "node scripts/generate-meta.mjs",
    "predev": "node scripts/sync-assets.mjs && node scripts/generate-meta.mjs",
    "dev": "vite",
    "prebuild": "node scripts/sync-assets.mjs && node scripts/generate-meta.mjs",
    "build": "vite build && vite build --ssr src/entry-server.tsx --outDir dist-ssr && node scripts/prerender.mjs",
    "typecheck": "node scripts/generate-meta.mjs && tsc --noEmit",
    "preview": "vite preview"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@mdx-js/react": "^3.1.1",
    "lucide-react": "^1.80.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router": "^8.5.3"
  },
  "devDependencies": {
    "@mdx-js/rollup": "^3.1.1",
    "@shikijs/rehype": "^4.6.0",
    "@tailwindcss/vite": "^4.3.5",
    "@types/node": "^26.6.10",
    "@types/react": "^19.3.3",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "github-slugger": "^2.0.0",
    "gray-matter": "^4.0.3",
    "rehype-slug": "^6.0.0",
    "remark-frontmatter": "^5.0.0",
    "remark-gfm": "^4.0.1",
    "remark-mdx-frontmatter": "^6.0.0",
    "tailwindcss": "^4.3.5",
    "typescript": "^7.0.2",
    "vite": "^8.3.8"
  }
}
